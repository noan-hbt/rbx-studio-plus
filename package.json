{
  "name": "rbx-studio-plus",
  "version": "0.1.0",
  "description": "Agent-friendly MCP server for Roblox Studio: auto studio selection, captured output, script sync to files, one-shot playtests.",
  "type": "module",
  "bin": { "rbx-studio-plus": "dist/src/index.js" },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/",
    "start": "node dist/src/index.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/noan-hbt/rbx-studio-plus.git" },
  "keywords": ["roblox", "roblox-studio", "mcp", "model-context-protocol", "luau", "claude-code", "codex", "rojo"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
